<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面用到 WinUI 3（Windows App SDK），它只能从 NuGet 还原，所以这里必须保留 nuget.org。
  程序本身仍然不引用其它第三方包：WinForms / System.Text.Json 都是 .NET 自带的。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
